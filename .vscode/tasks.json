{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "options": 
    {
        "env": {
            "DYLD_LIBRARY_PATH": "${workspaceFolder}/internal:$DYLD_LIBRARY_PATH"
        }
    },
    "tasks": [
        {
            "label": "Go build",
            "type": "shell",
            "command": "go build ./...",
            "problemMatcher":"$go",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}